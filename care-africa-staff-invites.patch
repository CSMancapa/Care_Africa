diff --git a/supabase/migrations/0007_staff_invites.sql b/supabase/migrations/0007_staff_invites.sql
new file mode 100644
index 0000000..caf9985
--- /dev/null
+++ b/supabase/migrations/0007_staff_invites.sql
@@ -0,0 +1,318 @@
+-- =====================================================================
+-- Care Africa — 0007 staff invites and roles
+-- =====================================================================
+-- Every person at a practice gets their own login (no shared passwords),
+-- so the practice can control and later audit who did what.
+--
+-- Roles (practice_members.role):
+--   practice_admin  "Practice admin"  everything, incl. settings and staff
+--   doctor          "Practitioner"    appointments and clinical records
+--   staff           "Front desk"      bookings, check-in, members, sales;
+--                                     NO clinical records
+--
+-- Invites: a practice admin creates an invitation for an email address
+-- and role. The app shows a one-time link the admin can send by WhatsApp
+-- or email. The person opens it, creates an account (or signs in) with
+-- that same email address, and joins the practice. Only a hash of the
+-- link's secret is stored. Links expire after 7 days.
+--
+-- Safety rules enforced here:
+--   * Only practice admins can invite, change roles or remove staff.
+--   * A practice can never be left without an active admin.
+--   * An invitation can only be accepted by a login with the invited
+--     email address.
+--   * Clinical tables (consultations, conditions, medications, visits,
+--     documents, prescriptions) are now limited to practitioners and
+--     admins. Front desk keeps bookings, members, sales and claims.
+-- =====================================================================
+
+begin;
+
+-- ---------------------------------------------------------------------
+-- Clinical access: practitioners and admins only
+-- ---------------------------------------------------------------------
+create or replace function auth_is_clinical_member(target_practice uuid)
+returns boolean language sql stable security definer set search_path = public as $$
+  select exists (
+    select 1 from practice_members
+    where profile_id = auth.uid()
+      and practice_id = target_practice
+      and role in ('doctor', 'practice_admin')
+      and is_active
+  );
+$$;
+revoke execute on function auth_is_clinical_member(uuid) from public;
+grant  execute on function auth_is_clinical_member(uuid) to authenticated;
+
+do $$
+declare t text;
+begin
+  foreach t in array array[
+    'consultations', 'patient_medications', 'patient_conditions',
+    'patient_visits', 'patient_documents'
+  ] loop
+    execute format($f$
+      drop policy if exists %1$s_staff_all on %1$s;
+      drop policy if exists %1$s_clinical_all on %1$s;
+      create policy %1$s_clinical_all on %1$s
+        for all using (auth_is_clinical_member(practice_id))
+        with check (auth_is_clinical_member(practice_id));
+    $f$, t);
+  end loop;
+end $$;
+
+drop policy if exists prescriptions_read on prescriptions;
+drop policy if exists prescriptions_staff_write on prescriptions;
+drop policy if exists prescriptions_clinical_write on prescriptions;
+
+create policy prescriptions_read on prescriptions
+  for select using (
+    exists (select 1 from consultations c
+            where c.id = prescriptions.consultation_id
+              and (auth_owns_patient(c.patient_id) or auth_is_clinical_member(c.practice_id)))
+  );
+
+create policy prescriptions_clinical_write on prescriptions
+  for all using (
+    exists (select 1 from consultations c
+            where c.id = prescriptions.consultation_id
+              and auth_is_clinical_member(c.practice_id))
+  )
+  with check (
+    exists (select 1 from consultations c
+            where c.id = prescriptions.consultation_id
+              and auth_is_clinical_member(c.practice_id))
+  );
+
+-- ---------------------------------------------------------------------
+-- Never leave a practice without an active admin
+-- ---------------------------------------------------------------------
+create or replace function guard_last_practice_admin()
+returns trigger language plpgsql as $$
+-- Runs as the caller (not security definer), so it can tell app users
+-- apart from Care Africa staff working in the SQL editor or with the
+-- service role, and from whole-practice or whole-account deletions.
+declare
+  v_was_admin   boolean := old.role = 'practice_admin' and old.is_active;
+  v_still_admin boolean := tg_op = 'UPDATE' and new.role = 'practice_admin' and new.is_active;
+begin
+  if current_user in ('anon', 'authenticated')
+     and v_was_admin and not v_still_admin
+     and not exists (
+       select 1 from practice_members
+       where practice_id = old.practice_id
+         and id <> old.id
+         and role = 'practice_admin'
+         and is_active
+     ) then
+    raise exception 'A practice needs at least one active admin'
+      using errcode = 'P0001',
+            hint = 'Make someone else an admin first.';
+  end if;
+  return case when tg_op = 'DELETE' then old else new end;
+end $$;
+
+drop trigger if exists practice_members_keep_admin on practice_members;
+create trigger practice_members_keep_admin
+  before update of role, is_active or delete on practice_members
+  for each row execute function guard_last_practice_admin();
+
+-- ---------------------------------------------------------------------
+-- Invitations
+-- ---------------------------------------------------------------------
+create table if not exists practice_invitations (
+  id           uuid primary key default gen_random_uuid(),
+  practice_id  uuid not null references practices(id) on delete cascade,
+  email        citext not null,
+  role         user_role not null
+                 check (role in ('staff', 'doctor', 'practice_admin')),
+  token_hash   text not null unique,
+  invited_by   uuid references profiles(id) on delete set null,
+  created_at   timestamptz not null default now(),
+  expires_at   timestamptz not null default now() + interval '7 days',
+  accepted_at  timestamptz,
+  accepted_by  uuid references profiles(id) on delete set null,
+  revoked_at   timestamptz
+);
+
+-- At most one open invitation per email per practice.
+create unique index if not exists practice_invitations_open_idx
+  on practice_invitations (practice_id, email)
+  where accepted_at is null and revoked_at is null;
+
+alter table practice_invitations enable row level security;
+
+drop policy if exists practice_invitations_admin_read on practice_invitations;
+create policy practice_invitations_admin_read on practice_invitations
+  for select using (auth_is_practice_admin(practice_id));
+-- No insert/update/delete policies: changes go through the functions below.
+
+grant select on practice_invitations to authenticated;
+
+create or replace function _invite_token_hash(p_token text)
+returns text language sql immutable as $$
+  select encode(sha256(convert_to(p_token, 'UTF8')), 'hex');
+$$;
+
+-- Create (or replace) an invitation. Returns the secret link token once;
+-- only its hash is stored.
+create or replace function create_invitation(p_practice uuid, p_email text, p_role user_role)
+returns table (invitation_id uuid, token text, expires_at timestamptz)
+language plpgsql security definer set search_path = public as $$
+declare
+  v_email citext := lower(btrim(p_email));
+  v_token text := replace(gen_random_uuid()::text || gen_random_uuid()::text, '-', '');
+  v_id uuid;
+  v_expires timestamptz;
+begin
+  if not auth_is_practice_admin(p_practice) then
+    raise exception 'Only a practice admin can invite staff' using errcode = '42501';
+  end if;
+  if p_role not in ('staff', 'doctor', 'practice_admin') then
+    raise exception 'Choose a role: front desk, practitioner or practice admin';
+  end if;
+  if v_email is null or v_email !~ '^[^@\s]+@[^@\s]+\.[^@\s]+$' then
+    raise exception 'Enter a valid email address';
+  end if;
+  if exists (
+    select 1 from practice_members m join profiles p on p.id = m.profile_id
+    where m.practice_id = p_practice and m.is_active and p.email = v_email
+  ) then
+    raise exception '% is already on your team', v_email;
+  end if;
+
+  -- A new invite replaces any open one for the same person.
+  update practice_invitations set revoked_at = now()
+   where practice_id = p_practice and email = v_email
+     and accepted_at is null and revoked_at is null;
+
+  insert into practice_invitations (practice_id, email, role, token_hash, invited_by)
+  values (p_practice, v_email, p_role, _invite_token_hash(v_token), auth.uid())
+  returning id, practice_invitations.expires_at into v_id, v_expires;
+
+  return query select v_id, v_token, v_expires;
+end $$;
+
+create or replace function revoke_invitation(p_invitation uuid)
+returns void language plpgsql security definer set search_path = public as $$
+declare v_practice uuid;
+begin
+  select practice_id into v_practice from practice_invitations where id = p_invitation;
+  if v_practice is null or not auth_is_practice_admin(v_practice) then
+    raise exception 'Only a practice admin can cancel invitations' using errcode = '42501';
+  end if;
+  update practice_invitations set revoked_at = now()
+   where id = p_invitation and accepted_at is null and revoked_at is null;
+end $$;
+
+-- What the invite page shows before anyone signs in. Knowing the token
+-- is the permission to see this.
+create or replace function get_invitation(p_token text)
+returns jsonb language plpgsql stable security definer set search_path = public as $$
+declare v practice_invitations%rowtype; v_name text;
+begin
+  select * into v from practice_invitations where token_hash = _invite_token_hash(p_token);
+  if not found then
+    return jsonb_build_object('status', 'invalid');
+  end if;
+  select name into v_name from practices where id = v.practice_id;
+  return jsonb_build_object(
+    'status', case
+                when v.accepted_at is not null then 'accepted'
+                when v.revoked_at  is not null then 'revoked'
+                when v.expires_at < now()      then 'expired'
+                else 'pending' end,
+    'practice_name', v_name,
+    'role', v.role,
+    'email', v.email,
+    'expires_at', v.expires_at
+  );
+end $$;
+
+-- Join the practice. The signed-in account's email must match the invite.
+create or replace function accept_invitation(p_token text)
+returns uuid language plpgsql security definer set search_path = public as $$
+declare
+  v practice_invitations%rowtype;
+  v_uid uuid := auth.uid();
+  v_email citext;
+begin
+  if v_uid is null then
+    raise exception 'Sign in to accept this invitation' using errcode = '42501';
+  end if;
+
+  select * into v from practice_invitations
+   where token_hash = _invite_token_hash(p_token)
+   for update;
+
+  if not found then
+    raise exception 'This invitation link isn''t valid';
+  end if;
+  if v.accepted_at is not null then
+    if v.accepted_by = v_uid then return v.practice_id; end if;
+    raise exception 'This invitation has already been used';
+  end if;
+  if v.revoked_at is not null then
+    raise exception 'This invitation was cancelled. Ask your practice admin for a new link.';
+  end if;
+  if v.expires_at < now() then
+    raise exception 'This invitation has expired. Ask your practice admin for a new link.';
+  end if;
+
+  select email into v_email from auth.users where id = v_uid;
+  if v_email is distinct from v.email then
+    raise exception 'This invitation was sent to %. Sign in with that email address.', v.email
+      using errcode = '42501';
+  end if;
+
+  insert into practice_members (practice_id, profile_id, role, is_active)
+  values (v.practice_id, v_uid, v.role, true)
+  on conflict (practice_id, profile_id)
+    do update set role = excluded.role, is_active = true;
+
+  -- People who signed up through an invite start as 'patient' profiles.
+  update profiles set role = v.role where id = v_uid and role = 'patient';
+
+  update practice_invitations set accepted_at = now(), accepted_by = v_uid where id = v.id;
+  return v.practice_id;
+end $$;
+
+-- Change a team member's role or remove (deactivate) them.
+create or replace function update_team_member(p_member uuid, p_role user_role, p_active boolean)
+returns void language plpgsql security definer set search_path = public as $$
+declare v_practice uuid;
+begin
+  select practice_id into v_practice from practice_members where id = p_member;
+  if v_practice is null or not auth_is_practice_admin(v_practice) then
+    raise exception 'Only a practice admin can change the team' using errcode = '42501';
+  end if;
+  if p_role not in ('staff', 'doctor', 'practice_admin') then
+    raise exception 'Choose a role: front desk, practitioner or practice admin';
+  end if;
+  -- Same rule as the trigger (which this security-definer function
+  -- would otherwise bypass): keep at least one active admin.
+  if exists (select 1 from practice_members
+              where id = p_member and role = 'practice_admin' and is_active)
+     and not (p_role = 'practice_admin' and p_active)
+     and not exists (select 1 from practice_members
+                      where practice_id = v_practice and id <> p_member
+                        and role = 'practice_admin' and is_active) then
+    raise exception 'A practice needs at least one active admin'
+      using errcode = 'P0001', hint = 'Make someone else an admin first.';
+  end if;
+  update practice_members set role = p_role, is_active = p_active where id = p_member;
+end $$;
+
+revoke execute on function _invite_token_hash(text) from public;
+revoke execute on function create_invitation(uuid, text, user_role) from public;
+revoke execute on function revoke_invitation(uuid) from public;
+revoke execute on function get_invitation(text) from public;
+revoke execute on function accept_invitation(text) from public;
+revoke execute on function update_team_member(uuid, user_role, boolean) from public;
+grant execute on function create_invitation(uuid, text, user_role) to authenticated;
+grant execute on function revoke_invitation(uuid) to authenticated;
+grant execute on function get_invitation(text) to anon, authenticated;
+grant execute on function accept_invitation(text) to authenticated;
+grant execute on function update_team_member(uuid, user_role, boolean) to authenticated;
+
+commit;
diff --git a/supabase/tests/staff_invites_test.sql b/supabase/tests/staff_invites_test.sql
new file mode 100644
index 0000000..6eafe9f
--- /dev/null
+++ b/supabase/tests/staff_invites_test.sql
@@ -0,0 +1,202 @@
+-- =====================================================================
+-- Care Africa — tests for 0007 (staff invites, roles, clinical access)
+-- =====================================================================
+--   psql "$DATABASE_URL" -f supabase/tests/staff_invites_test.sql
+-- Seeds data, asserts, then rolls back.
+-- =====================================================================
+
+begin;
+
+grant usage on schema public to authenticated, anon;
+grant all on all tables in schema public to authenticated;
+
+create or replace function _assert(label text, actual text, expected text)
+returns void language plpgsql as $$
+begin
+  if actual is distinct from expected then
+    raise exception 'FAIL  %  got[%] want[%]', label, actual, expected;
+  end if;
+  raise notice 'pass  %', label;
+end $$;
+
+-- Run a statement as a user ('anon' when actor is null); 'ok' or the error.
+create or replace function _try_as(actor uuid, q text)
+returns text language plpgsql as $$
+begin
+  perform set_config('request.jwt.claim.sub', coalesce(actor::text, ''), true);
+  perform set_config('role', case when actor is null then 'anon' else 'authenticated' end, true);
+  execute q;
+  perform set_config('role', 'postgres', true);
+  return 'ok';
+exception when others then
+  perform set_config('role', 'postgres', true);
+  return sqlerrm;
+end $$;
+
+-- Read one value as a user.
+create or replace function _read_as(actor uuid, q text)
+returns text language plpgsql as $$
+declare out text;
+begin
+  perform set_config('request.jwt.claim.sub', coalesce(actor::text, ''), true);
+  perform set_config('role', case when actor is null then 'anon' else 'authenticated' end, true);
+  execute q into out;
+  perform set_config('role', 'postgres', true);
+  return coalesce(out, '');
+exception when others then
+  perform set_config('role', 'postgres', true);
+  return 'ERROR: ' || sqlerrm;
+end $$;
+
+-- People:
+--   a1  owner of Seaview (practice admin)
+--   f1  will be invited as front desk
+--   d1  will be invited as practitioner
+--   x1  stranger with their own practice
+insert into auth.users (id, email, raw_user_meta_data) values
+  ('00000000-0000-0000-0000-0000000000a1', 'owner@seaview.test',  '{"practice_name":"Seaview"}'),
+  ('00000000-0000-0000-0000-0000000000f1', 'desk@seaview.test',   '{"full_name":"Fikile Desk"}'),
+  ('00000000-0000-0000-0000-0000000000d1', 'doc@seaview.test',    '{"full_name":"Dr Dube"}'),
+  ('00000000-0000-0000-0000-0000000000e1', 'other@elsewhere.test','{"practice_name":"Elsewhere"}');
+
+select set_config('t.p', (select practice_id::text from practice_members
+                           where profile_id = '00000000-0000-0000-0000-0000000000a1'), false);
+
+select _assert('invite signup does not create a practice',
+  (select count(*)::text from practice_members where profile_id = '00000000-0000-0000-0000-0000000000f1'), '0');
+
+-- ---------- creating invitations ----------
+select _assert('front desk cannot be invited by a stranger',
+  _try_as('00000000-0000-0000-0000-0000000000e1',
+    format('select create_invitation(%L, %L, %L)', current_setting('t.p'), 'desk@seaview.test', 'staff')),
+  'Only a practice admin can invite staff');
+
+create temp table tok (who text, token text);
+grant all on tok to authenticated, anon;
+
+select _try_as('00000000-0000-0000-0000-0000000000a1',
+  format('insert into tok select %L, token from create_invitation(%L, %L, %L)', 'desk', current_setting('t.p'), 'Desk@Seaview.test ', 'staff'));
+select _try_as('00000000-0000-0000-0000-0000000000a1',
+  format('insert into tok select %L, token from create_invitation(%L, %L, %L)', 'doc', current_setting('t.p'), 'doc@seaview.test', 'doctor'));
+select _assert('admin can invite (two invitations made)', (select count(*)::text from tok), '2');
+select _assert('only a hash of the token is stored',
+  (select count(*)::text from practice_invitations i join tok on i.token_hash = tok.token), '0');
+select _assert('admin can see the practice''s invitations',
+  _read_as('00000000-0000-0000-0000-0000000000a1', 'select count(*)::text from practice_invitations'), '2');
+select _assert('stranger cannot see them',
+  _read_as('00000000-0000-0000-0000-0000000000e1', 'select count(*)::text from practice_invitations'), '0');
+select _assert('bad email is refused',
+  _try_as('00000000-0000-0000-0000-0000000000a1',
+    format('select create_invitation(%L, %L, %L)', current_setting('t.p'), 'not-an-email', 'staff')),
+  'Enter a valid email address');
+select _assert('existing member cannot be invited again',
+  _try_as('00000000-0000-0000-0000-0000000000a1',
+    format('select create_invitation(%L, %L, %L)', current_setting('t.p'), 'owner@seaview.test', 'staff')),
+  'owner@seaview.test is already on your team');
+
+-- ---------- preview and accepting ----------
+select _assert('anyone with the link sees practice and role',
+  _read_as(null, format('select ((get_invitation(%L))->>%L) || %L || ((get_invitation(%L))->>%L)',
+    (select token from tok where who = 'desk'), 'practice_name', '/', (select token from tok where who = 'desk'), 'role')),
+  'Seaview/staff');
+select _assert('a made-up link is invalid',
+  _read_as(null, format('select (get_invitation(%L))->>%L', 'nope', 'status')), 'invalid');
+
+select _assert('the wrong account cannot accept',
+  _try_as('00000000-0000-0000-0000-0000000000d1',
+    format('select accept_invitation(%L)', (select token from tok where who = 'desk'))),
+  'This invitation was sent to desk@seaview.test. Sign in with that email address.');
+select _assert('signed-out people cannot accept',
+  _try_as(null, format('select accept_invitation(%L)', (select token from tok where who = 'desk'))),
+  'permission denied for function accept_invitation');
+
+select _assert('front desk accepts their invitation',
+  _try_as('00000000-0000-0000-0000-0000000000f1',
+    format('select accept_invitation(%L)', (select token from tok where who = 'desk'))), 'ok');
+select _assert('front desk is now a member with role staff',
+  (select role::text from practice_members where profile_id = '00000000-0000-0000-0000-0000000000f1'
+     and practice_id = current_setting('t.p')::uuid), 'staff');
+select _assert('accepting twice is harmless',
+  _try_as('00000000-0000-0000-0000-0000000000f1',
+    format('select accept_invitation(%L)', (select token from tok where who = 'desk'))), 'ok');
+select _assert('a used link shows as accepted',
+  _read_as(null, format('select (get_invitation(%L))->>%L', (select token from tok where who = 'desk'), 'status')), 'accepted');
+
+select _assert('practitioner accepts',
+  _try_as('00000000-0000-0000-0000-0000000000d1',
+    format('select accept_invitation(%L)', (select token from tok where who = 'doc'))), 'ok');
+
+-- ---------- expired and cancelled ----------
+select _try_as('00000000-0000-0000-0000-0000000000a1',
+  format('insert into tok select %L, token from create_invitation(%L, %L, %L)', 'late', current_setting('t.p'), 'late@seaview.test', 'staff'));
+update practice_invitations set expires_at = now() - interval '1 minute' where email = 'late@seaview.test';
+select _assert('expired links are refused',
+  _read_as(null, format('select (get_invitation(%L))->>%L', (select token from tok where who = 'late'), 'status')), 'expired');
+
+select _try_as('00000000-0000-0000-0000-0000000000a1',
+  format('insert into tok select %L, token from create_invitation(%L, %L, %L)', 'again', current_setting('t.p'), 'late@seaview.test', 'staff'));
+select _assert('a new invite replaces the old one',
+  (select count(*)::text from practice_invitations where email = 'late@seaview.test' and revoked_at is null and accepted_at is null), '1');
+select _try_as('00000000-0000-0000-0000-0000000000a1',
+  format('select revoke_invitation(%L)', (select id from practice_invitations where email = 'late@seaview.test' and revoked_at is null)));
+select _assert('admin can cancel an invitation',
+  _read_as(null, format('select (get_invitation(%L))->>%L', (select token from tok where who = 'again'), 'status')), 'revoked');
+
+-- ---------- clinical access by role ----------
+insert into patients (id, practice_id, first_name) values
+  ('00000000-0000-0000-0000-00000000aaaa', current_setting('t.p')::uuid, 'Thandi');
+insert into patient_conditions (practice_id, patient_id, name)
+  values (current_setting('t.p')::uuid, '00000000-0000-0000-0000-00000000aaaa', 'Asthma');
+
+select _assert('front desk can see members',
+  _read_as('00000000-0000-0000-0000-0000000000f1', 'select count(*)::text from patients'), '1');
+select _assert('front desk cannot see clinical records',
+  _read_as('00000000-0000-0000-0000-0000000000f1', 'select count(*)::text from patient_conditions'), '0');
+select _assert('front desk cannot write clinical records',
+  (_try_as('00000000-0000-0000-0000-0000000000f1',
+    format('insert into patient_conditions (practice_id, patient_id, name) values (%L, %L, %L)',
+      current_setting('t.p'), '00000000-0000-0000-0000-00000000aaaa', 'Flu')) like '%row-level security%')::text, 'true');
+select _assert('practitioner can see clinical records',
+  _read_as('00000000-0000-0000-0000-0000000000d1', 'select count(*)::text from patient_conditions'), '1');
+select _assert('admin can see clinical records',
+  _read_as('00000000-0000-0000-0000-0000000000a1', 'select count(*)::text from patient_conditions'), '1');
+
+-- ---------- managing the team ----------
+select _assert('front desk cannot change roles',
+  _try_as('00000000-0000-0000-0000-0000000000f1',
+    format('select update_team_member(%L, %L, true)',
+      (select id from practice_members where profile_id = '00000000-0000-0000-0000-0000000000f1'), 'practice_admin')),
+  'Only a practice admin can change the team');
+
+select _assert('the only admin cannot step down',
+  _try_as('00000000-0000-0000-0000-0000000000a1',
+    format('select update_team_member(%L, %L, true)',
+      (select id from practice_members where profile_id = '00000000-0000-0000-0000-0000000000a1'), 'doctor')),
+  'A practice needs at least one active admin');
+select _assert('the only admin cannot be removed directly either',
+  _try_as('00000000-0000-0000-0000-0000000000a1',
+    format('update practice_members set is_active = false where profile_id = %L', '00000000-0000-0000-0000-0000000000a1')),
+  'A practice needs at least one active admin');
+
+select _assert('admin can promote the practitioner to admin',
+  _try_as('00000000-0000-0000-0000-0000000000a1',
+    format('select update_team_member(%L, %L, true)',
+      (select id from practice_members where profile_id = '00000000-0000-0000-0000-0000000000d1'), 'practice_admin')), 'ok');
+select _assert('with two admins, the owner can step down',
+  _try_as('00000000-0000-0000-0000-0000000000a1',
+    format('select update_team_member(%L, %L, true)',
+      (select id from practice_members where profile_id = '00000000-0000-0000-0000-0000000000a1'), 'doctor')), 'ok');
+
+select _assert('new admin removes front desk',
+  _try_as('00000000-0000-0000-0000-0000000000d1',
+    format('select update_team_member(%L, %L, false)',
+      (select id from practice_members where profile_id = '00000000-0000-0000-0000-0000000000f1'), 'staff')), 'ok');
+select _assert('removed staff lose access to members',
+  _read_as('00000000-0000-0000-0000-0000000000f1', 'select count(*)::text from patients'), '0');
+
+-- Care Africa (SQL editor) can still delete a whole practice.
+delete from practices where id = current_setting('t.p')::uuid;
+select _assert('deleting a practice is not blocked by the admin rule',
+  (select count(*)::text from practices where id = current_setting('t.p')::uuid), '0');
+
+rollback;
-- 
