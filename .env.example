# Copy to .env and fill in. Never commit .env.
# Supabase dashboard -> Connect (or Settings -> API Keys)
VITE_SUPABASE_URL=
# The publishable key (sb_publishable_...) or the legacy anon key. NEVER the secret/service_role key.
VITE_SUPABASE_ANON_KEY=

# Optional: Google Maps key for address autocomplete. Without it the field is a plain text box.
VITE_GOOGLE_MAPS_API_KEY=
