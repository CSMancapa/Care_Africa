diff --git a/supabase/migrations/0006_practice_modules.sql b/supabase/migrations/0006_practice_modules.sql
new file mode 100644
index 0000000..0a08eb0
--- /dev/null
+++ b/supabase/migrations/0006_practice_modules.sql
@@ -0,0 +1,122 @@
+-- =====================================================================
+-- Care Africa — 0006 practice modules
+-- =====================================================================
+-- Different kinds of practice get different features (decision of
+-- 21 Nov 2026, see the project's practice-modules decision record):
+--
+--   * The retention core (bookings, waiting room, members, loyalty,
+--     rewards, retail) is always on and has no switch.
+--   * Clinical records have three levels:
+--       off     no clinical screens (e.g. a massage studio)
+--       intake  intake / contraindication forms only (spa, beauty)
+--       full    full clinical notes, vitals, prescriptions
+--   * Medical-aid claims are a separate module.
+--
+-- Who decides what:
+--   * The practice type picked at onboarding suggests defaults (in the
+--     app, src/lib/practiceTypes.ts).
+--   * The subscription plan sets the limits, enforced here:
+--       starter   clinical records up to "intake", no claims
+--       practice  everything
+--       network   everything
+--   * A practice admin can change the modules within those limits.
+--   * Only Care Africa (service role / SQL editor) can change the plan.
+-- =====================================================================
+
+begin;
+
+alter table practices
+  add column if not exists plan text not null default 'practice'
+        check (plan in ('starter', 'practice', 'network')),
+  add column if not exists clinical_records text not null default 'off'
+        check (clinical_records in ('off', 'intake', 'full')),
+  add column if not exists claims_enabled boolean not null default false;
+
+comment on column practices.plan is
+  'Subscription plan. Sets which modules are allowed. Changed by Care Africa only.';
+comment on column practices.clinical_records is
+  'Clinical records module: off, intake (forms only) or full (notes, vitals, prescriptions).';
+comment on column practices.claims_enabled is
+  'Medical-aid claims module.';
+
+-- ---------------------------------------------------------------------
+-- Plan limits and who may change the plan
+-- ---------------------------------------------------------------------
+create or replace function enforce_practice_plan()
+returns trigger language plpgsql as $$
+declare
+  -- App users reach the database as anon/authenticated. Care Africa staff
+  -- use the service role or the SQL editor (postgres).
+  v_is_app_user boolean := current_user in ('anon', 'authenticated');
+begin
+  if v_is_app_user then
+    if tg_op = 'INSERT' and new.plan is distinct from 'practice' then
+      raise exception 'Only Care Africa can choose a practice''s plan'
+        using errcode = '42501';
+    end if;
+    if tg_op = 'UPDATE' and new.plan is distinct from old.plan then
+      raise exception 'Only Care Africa can change a practice''s plan'
+        using errcode = '42501';
+    end if;
+  end if;
+
+  if new.plan = 'starter' and new.clinical_records = 'full' then
+    raise exception 'Full clinical notes are not included in the Starter plan'
+      using errcode = 'P0001', hint = 'Upgrade to the Practice plan, or choose intake forms only.';
+  end if;
+
+  if new.plan = 'starter' and new.claims_enabled then
+    raise exception 'Medical-aid claims are not included in the Starter plan'
+      using errcode = 'P0001', hint = 'Upgrade to the Practice plan.';
+  end if;
+
+  return new;
+end $$;
+
+drop trigger if exists practices_enforce_plan on practices;
+create trigger practices_enforce_plan
+  before insert or update of plan, clinical_records, claims_enabled on practices
+  for each row execute function enforce_practice_plan();
+
+-- ---------------------------------------------------------------------
+-- Practice types. Settings used to take free text ("Dental Practice"),
+-- so map what's there onto the fixed list the app now uses.
+-- ---------------------------------------------------------------------
+update practices set category = case
+    when category in ('dental', 'medical', 'physio', 'chiro', 'optometry',
+                      'psychology', 'nutrition', 'biokinetics', 'aesthetics',
+                      'iv_therapy', 'nurse_clinic', 'wellness', 'beauty',
+                      'alternative', 'other')                       then category
+    when category ~* 'dent|orthodon'                               then 'dental'
+    when category ~* 'optom|eye|vision|optic'                      then 'optometry'
+    when category ~* 'physio'                                      then 'physio'
+    when category ~* 'chiro'                                       then 'chiro'
+    when category ~* 'bioki'                                       then 'biokinetics'
+    when category ~* 'psych|counsel|therap(y|ist) ?$'              then 'psychology'
+    when category ~* 'nutri|diet'                                  then 'nutrition'
+    when category ~* 'drip|infusion|\miv\M'                      then 'iv_therapy'
+    when category ~* 'aesthet|botox|filler|skin'                   then 'aesthetics'
+    when category ~* 'nurse|clinic'                                then 'nurse_clinic'
+    when category ~* 'spa|massage|wellness'                        then 'wellness'
+    when category ~* 'beauty|salon|nail|lash|brow'                 then 'beauty'
+    when category ~* 'medical|doctor|\mgp\M|general pract'       then 'medical'
+    when category ~* 'homeo|natur|acupunct|altern|holistic'        then 'alternative'
+    else 'other'
+  end;
+
+-- ---------------------------------------------------------------------
+-- Existing practices: switch modules on from the practice type they
+-- already chose. Claims stay off until the claims module is released.
+-- ---------------------------------------------------------------------
+update practices set clinical_records = case
+    when category in ('dental', 'medical', 'physio', 'chiro', 'optometry',
+                      'psychology', 'nutrition', 'biokinetics', 'aesthetics',
+                      'iv_therapy', 'nurse_clinic')
+      then 'full'
+    when category in ('wellness', 'beauty', 'alternative', 'other')
+      then 'intake'
+    else 'intake'
+  end
+where clinical_records = 'off';
+
+commit;
diff --git a/supabase/tests/practice_modules_test.sql b/supabase/tests/practice_modules_test.sql
new file mode 100644
index 0000000..18fae72
--- /dev/null
+++ b/supabase/tests/practice_modules_test.sql
@@ -0,0 +1,134 @@
+-- =====================================================================
+-- Care Africa — tests for 0006 (practice modules and plan limits)
+-- =====================================================================
+-- Same style as the other tests: seeds data, asserts, then rolls back.
+--
+--   psql "$DATABASE_URL" -f supabase/tests/practice_modules_test.sql
+-- =====================================================================
+
+begin;
+
+create or replace function _assert(label text, actual text, expected text)
+returns void language plpgsql as $$
+begin
+  if actual is distinct from expected then
+    raise exception 'FAIL  %  got[%] want[%]', label, actual, expected;
+  end if;
+  raise notice 'pass  %', label;
+end $$;
+
+-- Runs a statement as an app user; returns 'ok' or the error message.
+create or replace function _try_as(actor uuid, q text)
+returns text language plpgsql as $$
+begin
+  perform set_config('request.jwt.claim.sub', actor::text, true);
+  perform set_config('role', 'authenticated', true);
+  execute q;
+  perform set_config('role', 'postgres', true);
+  return 'ok';
+exception when others then
+  perform set_config('role', 'postgres', true);
+  return sqlerrm;
+end $$;
+
+-- Reads one value as an app user.
+create or replace function _read_as(actor uuid, q text)
+returns text language plpgsql as $$
+declare out text;
+begin
+  perform set_config('request.jwt.claim.sub', actor::text, true);
+  perform set_config('role', 'authenticated', true);
+  execute q into out;
+  perform set_config('role', 'postgres', true);
+  return coalesce(out, '');
+end $$;
+
+-- Supabase grants these by default; a bare Postgres needs them spelt out.
+grant usage on schema public to authenticated;
+grant all on all tables in schema public to authenticated;
+
+-- Two users sign up; each gets a practice. Make B a staff member at A.
+insert into auth.users (id, email, raw_user_meta_data) values
+  ('00000000-0000-0000-0000-0000000000a1', 'admin@spa.test',    '{"practice_name":"Calm Spa"}'),
+  ('00000000-0000-0000-0000-0000000000b1', 'staff@spa.test',    '{"practice_name":"Staff Own Practice"}');
+
+do $$
+declare v_a uuid; v_staff uuid := '00000000-0000-0000-0000-0000000000b1';
+begin
+  select practice_id into v_a from practice_members
+   where profile_id = '00000000-0000-0000-0000-0000000000a1';
+  insert into practice_members (practice_id, profile_id, role) values (v_a, v_staff, 'staff');
+  perform set_config('test.practice_a', v_a::text, true);
+end $$;
+
+-- New practices: Practice plan, modules off until onboarding sets them.
+select _assert('new practice starts on the Practice plan',
+  (select plan from practices where id = current_setting('test.practice_a')::uuid), 'practice');
+select _assert('new practice starts with clinical records off',
+  (select clinical_records from practices where id = current_setting('test.practice_a')::uuid), 'off');
+select _assert('new practice starts with claims off',
+  (select claims_enabled::text from practices where id = current_setting('test.practice_a')::uuid), 'false');
+
+-- Admin may set modules within the plan.
+select _assert('admin can switch on full clinical notes',
+  _try_as('00000000-0000-0000-0000-0000000000a1',
+    format('update practices set clinical_records = %L where id = %L', 'full', current_setting('test.practice_a'))), 'ok');
+select _assert('admin can switch on claims on the Practice plan',
+  _try_as('00000000-0000-0000-0000-0000000000a1',
+    format('update practices set claims_enabled = true where id = %L', current_setting('test.practice_a'))), 'ok');
+select _assert('admin sees the saved level',
+  _read_as('00000000-0000-0000-0000-0000000000a1',
+    format('select clinical_records from practices where id = %L', current_setting('test.practice_a'))), 'full');
+
+-- Admin may not change the plan.
+select _assert('admin cannot change the plan',
+  _try_as('00000000-0000-0000-0000-0000000000a1',
+    format('update practices set plan = %L where id = %L', 'network', current_setting('test.practice_a'))),
+  'Only Care Africa can change a practice''s plan');
+
+-- Staff (not admin) cannot change modules: RLS filters the row, nothing changes.
+select _try_as('00000000-0000-0000-0000-0000000000b1',
+  format('update practices set clinical_records = %L where id = %L', 'off', current_setting('test.practice_a')));
+select _assert('staff cannot change modules',
+  (select clinical_records from practices where id = current_setting('test.practice_a')::uuid), 'full');
+
+-- Invalid level is refused by the check constraint.
+select _assert('unknown clinical level is refused',
+  (_try_as('00000000-0000-0000-0000-0000000000a1',
+    format('update practices set clinical_records = %L where id = %L', 'some', current_setting('test.practice_a'))) like '%check constraint%')::text,
+  'true');
+
+-- Care Africa moves the practice to Starter: must first bring modules within limits.
+do $$ begin
+  update practices set plan = 'starter' where id = current_setting('test.practice_a')::uuid;
+  raise exception 'should not reach';
+exception when others then
+  perform set_config('test.err', sqlerrm, true);
+end $$;
+select _assert('plan cannot drop to Starter while full notes are on',
+  current_setting('test.err'), 'Full clinical notes are not included in the Starter plan');
+
+update practices set plan = 'starter', clinical_records = 'intake', claims_enabled = false
+ where id = current_setting('test.practice_a')::uuid;
+select _assert('Care Africa can change the plan',
+  (select plan from practices where id = current_setting('test.practice_a')::uuid), 'starter');
+
+-- On Starter, the admin can use intake forms but not full notes or claims.
+select _assert('Starter admin can switch clinical records off',
+  _try_as('00000000-0000-0000-0000-0000000000a1',
+    format('update practices set clinical_records = %L where id = %L', 'off', current_setting('test.practice_a'))), 'ok');
+select _assert('Starter admin cannot switch on full notes',
+  _try_as('00000000-0000-0000-0000-0000000000a1',
+    format('update practices set clinical_records = %L where id = %L', 'full', current_setting('test.practice_a'))),
+  'Full clinical notes are not included in the Starter plan');
+select _assert('Starter admin cannot switch on claims',
+  _try_as('00000000-0000-0000-0000-0000000000a1',
+    format('update practices set claims_enabled = true where id = %L', current_setting('test.practice_a'))),
+  'Medical-aid claims are not included in the Starter plan');
+
+-- Other practice settings still save normally for an admin.
+select _assert('admin can still rename the practice',
+  _try_as('00000000-0000-0000-0000-0000000000a1',
+    format('update practices set name = %L where id = %L', 'Calm Spa & Wellness', current_setting('test.practice_a'))), 'ok');
+
+rollback;
-- 
